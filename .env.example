# No external DB_HOST. Compose connects to its own postgres:5432 service.
# Required: fill these before deploying. Use different random values.
DB_USER=nodeplane
DB_PASSWORD=
JWT_SECRET=
REGISTER_INVITE_CODE=

# Public frontend URL + /api (use your HTTPS domain in Coolify).
BASE_URL=http://localhost:18080/api

# All three application images must use the same published version.
NODEPLANE_IMAGE_PREFIX=ghcr.io/asharca/nodeplane
SUBS_CHECK_IMAGE_TAG=latest

# Database credentials are applied only when postgres_data is first initialized.
# Changing DB_PASSWORD later does not change the password stored in PostgreSQL.
