{
  "$schema": "https://encore.dev/schemas/infra.schema.json",
  "metadata": {
    "app_id": "nodeplane",
    "env_name": "production",
    "env_type": "production",
    "cloud": "local",
    "base_url": "http://backend:8080"
  },
  "sql_servers": [
    {
      "host": "postgres:5432",
      "tls_config": { "disabled": true },
      "databases": {
        "auth": { "username": { "$env": "DB_USER" }, "password": { "$env": "DB_PASSWORD" }, "max_connections": 10, "min_connections": 0 },
        "subscription": { "username": { "$env": "DB_USER" }, "password": { "$env": "DB_PASSWORD" }, "max_connections": 10, "min_connections": 0 },
        "checker": { "username": { "$env": "DB_USER" }, "password": { "$env": "DB_PASSWORD" }, "max_connections": 10, "min_connections": 0 },
        "scheduler": { "username": { "$env": "DB_USER" }, "password": { "$env": "DB_PASSWORD" }, "max_connections": 10, "min_connections": 0 },
        "notify": { "username": { "$env": "DB_USER" }, "password": { "$env": "DB_PASSWORD" }, "max_connections": 10, "min_connections": 0 },
        "settings": { "username": { "$env": "DB_USER" }, "password": { "$env": "DB_PASSWORD" }, "max_connections": 10, "min_connections": 0 }
      }
    }
  ],
  "secrets": { "JWTSecret": { "$env": "JWT_SECRET" } },
  "pubsub": [
    {
      "type": "nsq",
      "hosts": "nsq:4150",
      "topics": {
        "job-completed": {
          "name": "job-completed",
          "subscriptions": { "notify-on-job-completed": { "name": "notify-on-job-completed" } }
        }
      }
    }
  ]
}
